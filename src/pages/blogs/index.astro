---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import ContactFooter from '@/components/home/ContactFooter.astro';
import { siteConfig, nav, footer } from '@/data/site';

const blogCollection = await getCollection('blogs');
const articles = blogCollection
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((e, i) => ({
    slug: e.id.replace(/\/index$/, ''),
    title: e.data.title,
    date: e.data.date.toISOString().split('T')[0],
    excerpt: e.data.excerpt,
    author: e.data.author,
    image: e.data.image,
    _i: i,
  }));

const columns = [
  articles.filter((_, i) => i % 2 === 0),
  articles.filter((_, i) => i % 2 !== 0),
];

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });
}
---

<Layout
  title={`Blog — ${siteConfig.name}`}
  description="Insights, trends, and updates straight from our team."
>
  <Nav data={nav} />

  <main class="pt-14">
    <!-- Page header -->
    <div class="border-b border-[var(--line)] bg-[var(--surface)] py-20">
      <div class="max-w-7xl mx-auto px-6 lg:px-8" data-reveal>
        <p class="font-mono text-xs tracking-widest uppercase text-[var(--primary)] mb-4">
          Our Blog
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight" style="color: var(--ink);">
          Latest Articles
        </h1>
        <p class="mt-4 text-[var(--muted-foreground)] leading-relaxed max-w-xl">
          Insights, trends, and updates straight from our team.
        </p>
      </div>
    </div>

    <!-- Article masonry -->
    <section class="py-24 bg-[var(--background)]">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {columns.map((col) => (
            <div class="flex flex-col gap-4">
              {col.map((article) => (
                <a
                  href={`/blogs/${article.slug}`}
                  class="
                    group block
                    border border-[var(--line)] bg-[var(--background)]
                    hover:bg-[var(--card)]
                    transition-colors duration-150
                  "
                  data-reveal
                  style={`transition-delay: ${article._i * 60}ms`}
                >
                  {article.image && (
                    <div class="overflow-hidden aspect-[3/2]">
                      <Image
                        src={article.image}
                        alt={article.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        widths={[400, 800]}
                        sizes="(max-width: 640px) 100vw, 50vw"
                      />
                    </div>
                  )}
                  <div class="p-6">
                    <p class="font-mono text-xs tracking-widest uppercase text-[var(--muted-foreground)] mb-3">
                      {formatDate(article.date)}
                      {article.author && (
                        <span class="ml-3 opacity-60">— {article.author}</span>
                      )}
                    </p>
                    <h2
                      class="
                        text-base font-semibold leading-snug mb-3
                        group-hover:text-[var(--primary)]
                        transition-colors duration-150
                      "
                      style="color: var(--ink);"
                    >
                      {article.title}
                    </h2>
                    {article.excerpt && (
                      <p class="text-sm text-[var(--muted-foreground)] leading-relaxed mb-4 line-clamp-3">
                        {article.excerpt}
                      </p>
                    )}
                    <span
                      class="
                        font-mono text-xs tracking-widest uppercase
                        text-[var(--muted-foreground)]
                        group-hover:text-[var(--primary)]
                        transition-colors duration-150
                        inline-flex items-center gap-1
                      "
                    >
                      Read more
                      <span
                        aria-hidden="true"
                        class="
                          inline-block translate-x-0
                          group-hover:translate-x-1
                          transition-transform duration-150
                        "
                      >→</span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <ContactFooter data={footer} />
</Layout>
