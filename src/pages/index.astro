---
import { getCollection } from 'astro:content';

import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/home/Hero.astro';
import OurServices from '@/components/home/OurServices.astro';
import { PlatformSolutions } from '@/components/home/PlatformSolutions';
import ValueProps from '@/components/home/ValueProps.astro';
import Clients from '@/components/home/Clients.astro';
import Team from '@/components/home/Team.astro';
import FounderQuote from '@/components/home/FounderQuote.astro';
import Blog from '@/components/home/Blog.astro';
import ContactFooter from '@/components/home/ContactFooter.astro';

import { siteConfig, nav, footer } from '@/data/site';
import {
  hero, ourServices as ourServicesMeta,
  platform, valueProps, clients, team,
  founderQuote, blog as blogMeta,
} from '@/data/home';
import { projectCategories } from '@/data/project-categories';

/* ── Services collection ────────────────────────────── */
const servicesCollection = await getCollection('services');
const ourServices = {
  ...ourServicesMeta,
  items: servicesCollection
    .sort((a, b) => a.data.index.localeCompare(b.data.index))
    .map((e) => ({ ...e.data, body: e.body })),
};

/* ── Founder quotes collection ──────────────────────── */
const founderQuotesCollection = await getCollection('founderQuotes');

/* ── Projects collection ────────────────────────────── */
const projectsCollection = await getCollection('projects');
const platformData = {
  ...platform,
  tabs: projectCategories,
  projects: projectsCollection
    .filter((e) => !e.data.archived)
    .map((e) => ({
      id: e.id.replace(/\/index$/, ''),
      title: e.data.title,
      categories: e.data.categories,
      image: e.data.image,
      featured: e.data.featured,
    })),
};

/* ── Blog collection ────────────────────────────────── */
const blogCollection = await getCollection('blogs');
const blog = {
  ...blogMeta,
  articles: blogCollection
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .slice(0, 4)
    .map((e) => ({
      title: e.data.title,
      date: e.data.date.toISOString().split('T')[0],
      href: `/blogs/${e.id}`,
      excerpt: e.data.excerpt,
    })),
};
---

<Layout
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  description={siteConfig.description}
>
  <Nav data={nav} />

  <main>
    <Hero data={hero} />
    <OurServices data={ourServices} />
    <PlatformSolutions data={platformData} client:visible />
    <ValueProps data={valueProps} />
    <Clients data={clients} />
    <Team data={team} />
    <FounderQuote data={founderQuote} quotes={founderQuotesCollection} />
    <Blog data={blog} />
  </main>

  <ContactFooter data={footer} />
</Layout>
