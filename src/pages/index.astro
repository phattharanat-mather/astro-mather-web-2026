---
import { getCollection, getEntry } from 'astro:content';

import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/home/Hero.astro';
import OurServices from '@/components/home/OurServices.astro';
import { PlatformSolutions } from '@/components/home/PlatformSolutions';
import ValueProps from '@/components/home/ValueProps.astro';
import Clients from '@/components/home/Clients.astro';
import Team from '@/components/home/Team.astro';
import FounderQuote from '@/components/home/FounderQuote.astro';
import Blog from '@/components/home/Blog.astro';
import ContactFooter from '@/components/home/ContactFooter.astro';

import { siteConfig } from '@/data/site';

/* ── Singleton sections ─────────────────────────────── */
const [navEntry, heroEntry, ourServicesEntry, platformEntry, valuePropsEntry,
       clientsEntry, teamEntry, founderQuoteEntry, blogMetaEntry, footerEntry] =
  await Promise.all([
    getEntry('site', 'nav'),
    getEntry('site', 'hero'),
    getEntry('site', 'our-services'),
    getEntry('site', 'platform'),
    getEntry('site', 'value-props'),
    getEntry('site', 'clients'),
    getEntry('site', 'team'),
    getEntry('site', 'founder-quote'),
    getEntry('site', 'blog'),
    getEntry('site', 'footer'),
  ]);

/* ── Services collection ────────────────────────────── */
const servicesCollection = await getCollection('services');
const ourServices = {
  ...ourServicesEntry.data,
  items: servicesCollection
    .sort((a, b) => a.data.index.localeCompare(b.data.index))
    .map((e) => e.data),
};

/* ── Blog collection ────────────────────────────────── */
const blogCollection = await getCollection('blog');
const blog = {
  ...blogMetaEntry.data,
  articles: blogCollection
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .slice(0, 4)
    .map((e) => ({
      title: e.data.title,
      date: e.data.date.toISOString().split('T')[0],
      href: `/blogs/${e.id}`,
      excerpt: e.data.excerpt,
    })),
};
---

<Layout
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  description={siteConfig.description}
>
  <Nav data={navEntry.data} />

  <main>
    <Hero data={heroEntry.data} />
    <OurServices data={ourServices} />
    <PlatformSolutions data={platformEntry.data} client:visible />
    <ValueProps data={valuePropsEntry.data} />
    <Clients data={clientsEntry.data} />
    <Team data={teamEntry.data} />
    <FounderQuote data={founderQuoteEntry.data} />
    <Blog data={blog} />
  </main>

  <ContactFooter data={footerEntry.data} />
</Layout>
