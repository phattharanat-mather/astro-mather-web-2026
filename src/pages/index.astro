---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/sections/Hero.astro';
import OurServices from '@/components/sections/OurServices.astro';
import { PlatformSolutions } from '@/components/sections/PlatformSolutions';
import ValueProps from '@/components/sections/ValueProps.astro';
import Clients from '@/components/sections/Clients.astro';
import Team from '@/components/sections/Team.astro';
import FounderQuote from '@/components/sections/FounderQuote.astro';
import Blog from '@/components/sections/Blog.astro';
import ContactFooter from '@/components/sections/ContactFooter.astro';

import homeData from '@/content/home.json';
import { siteConfig } from '@/data/site';
---

<Layout
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  description={siteConfig.description}
>
  <Nav data={homeData.nav} />

  <main>
    <Hero data={homeData.hero} />
    <OurServices data={homeData.ourServices} />
    <PlatformSolutions data={homeData.platformSolutions} client:visible />
    <ValueProps data={homeData.valueProps} />
    <Clients data={homeData.clients} />
    <Team data={homeData.team} />
    <FounderQuote data={homeData.founderQuote} />
    <Blog data={homeData.blog} />
  </main>

  <ContactFooter data={homeData.footer} />
</Layout>
