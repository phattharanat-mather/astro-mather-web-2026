---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import ContactFooter from '@/components/home/ContactFooter.astro';
import { siteConfig, nav, footer } from '@/data/site';

const allPages = await getCollection('credentialPages');
const pages = allPages
  .filter(p => !p.data.hide)
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((p, i) => ({
    slug: p.id.replace(/\/index$/, ''),
    title: p.data.title,
    num: i + 1,
  }));

const firstSlug = pages[0]?.slug ?? null;
---

<Layout
  title={`Credentials — ${siteConfig.name}`}
  description="Our credential presentation."
>
  <Nav data={nav} />

  <main class="pt-14">
    <!-- Header -->
    <div class="border-b border-[var(--line)] bg-[var(--surface)] py-20">
      <div class="max-w-7xl mx-auto px-6 lg:px-8" data-reveal>
        <p class="font-mono text-xs tracking-widest uppercase text-[var(--primary)] mb-4">
          Credentials
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight" style="color: var(--ink);">
          Our Presentation
        </h1>
        <p class="mt-4 text-[var(--muted-foreground)] leading-relaxed max-w-xl">
          Browse our credential pages below, or jump straight into the presentation.
        </p>
        {firstSlug && (
          <a
            href={`/credential/${firstSlug}`}
            class="
              mt-8 inline-flex items-center gap-2
              bg-[var(--primary)] text-[var(--primary-foreground)]
              font-mono text-xs tracking-widest uppercase
              px-5 py-3
              hover:opacity-90 transition-opacity duration-150
            "
          >
            Present
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>

    <!-- Page list -->
    <section class="py-24 bg-[var(--background)]">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <ol class="divide-y divide-[var(--line)] border border-[var(--line)]">
          {pages.map((item) => (
            <li>
              <a
                href={`/credential/${item.slug}`}
                class="
                  group flex items-center gap-6 px-8 py-6
                  bg-[var(--background)] hover:bg-[var(--card)]
                  transition-colors duration-150
                "
                data-reveal
              >
                <span class="font-mono text-xs text-[var(--muted-foreground)] opacity-50 w-8 flex-shrink-0">
                  {String(item.num).padStart(2, '0')}
                </span>
                <span
                  class="
                    flex-1 text-base font-semibold
                    group-hover:text-[var(--primary)]
                    transition-colors duration-150
                  "
                  style="color: var(--ink);"
                >
                  {item.title}
                </span>
                <span
                  class="
                    font-mono text-xs tracking-widest uppercase
                    text-[var(--muted-foreground)]
                    group-hover:text-[var(--primary)]
                    transition-colors duration-150
                    inline-flex items-center gap-1
                  "
                >
                  View
                  <span
                    aria-hidden="true"
                    class="
                      inline-block translate-x-0
                      group-hover:translate-x-1
                      transition-transform duration-150
                    "
                  >→</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>

  <ContactFooter data={footer} />
</Layout>
