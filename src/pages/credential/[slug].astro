---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/data/site';

export async function getStaticPaths() {
  const allPages = await getCollection('credentialPages');
  const visible = allPages
    .filter(p => !p.data.hide)
    .sort((a, b) => a.id.localeCompare(b.id));

  return visible.map((page, i) => ({
    params: { slug: page.id.replace(/\/index$/, '') },
    props: {
      page,
      prev: visible[i - 1] ?? null,
      next: visible[i + 1] ?? null,
      current: i + 1,
      total: visible.length,
      all: visible.map(p => ({
        slug: p.id.replace(/\/index$/, ''),
        title: p.data.title,
      })),
    },
  }));
}

const { page, prev, next, current, total, all } = Astro.props;
const currentSlug = page.id.replace(/\/index$/, '');

const { Content } = await render(page);

const prevSlug = prev ? prev.id.replace(/\/index$/, '') : null;
const nextSlug = next ? next.id.replace(/\/index$/, '') : null;
---

<Layout
  title={`${page.data.title} — Credentials — ${siteConfig.name}`}
  description={`Credential presentation: ${page.data.title}`}
>
  <div class="credential-shell">
    <!-- Top bar -->
    <header class="credential-topbar">
      <a href="/" class="credential-home-link">
        <span aria-hidden="true">←</span>
        <span>{siteConfig.name}</span>
      </a>

      <div class="credential-page-counter">
        <span class="page-num">{current}</span>
        <span class="page-sep">/</span>
        <span class="page-total">{total}</span>
      </div>
    </header>

    <div class="credential-body">
      <!-- Sidebar: page list -->
      <nav class="credential-sidebar" aria-label="Presentation pages">
        <p class="sidebar-label">Pages</p>
        <ol class="sidebar-list">
          {all.map((item, i) => (
            <li>
              <a
                href={`/credential/${item.slug}`}
                class:list={['sidebar-item', { active: item.slug === currentSlug }]}
              >
                <span class="sidebar-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="sidebar-title">{item.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <!-- Main content -->
      <main class="credential-content">
        <div class="credential-slide">
          <p class="slide-label">
            {String(current).padStart(2, '0')} — {page.data.title}
          </p>
          <div class="prose-content slide-body">
            <Content />
          </div>
        </div>

        <!-- Prev / Next navigation -->
        <div class="credential-nav">
          {prevSlug ? (
            <a href={`/credential/${prevSlug}`} class="nav-btn nav-prev">
              <span aria-hidden="true">←</span>
              <span class="nav-label">{prev!.data.title}</span>
            </a>
          ) : (
            <span class="nav-btn nav-prev disabled" aria-disabled="true">
              <span aria-hidden="true">←</span>
            </span>
          )}

          <div class="nav-dots" aria-hidden="true">
            {all.map((item) => (
              <a
                href={`/credential/${item.slug}`}
                class:list={['nav-dot', { active: item.slug === currentSlug }]}
                tabindex="-1"
              />
            ))}
          </div>

          {nextSlug ? (
            <a href={`/credential/${nextSlug}`} class="nav-btn nav-next">
              <span class="nav-label">{next!.data.title}</span>
              <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span class="nav-btn nav-next disabled" aria-disabled="true">
              <span aria-hidden="true">→</span>
            </span>
          )}
        </div>
      </main>
    </div>
  </div>
</Layout>

<!-- Keyboard navigation -->
<script define:vars={{ prevSlug, nextSlug }}>
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft' && prevSlug) {
      window.location.href = `/credential/${prevSlug}`;
    }
    if (e.key === 'ArrowRight' && nextSlug) {
      window.location.href = `/credential/${nextSlug}`;
    }
  });
</script>

<style>
  /* Shell: full-viewport presentation layout */
  .credential-shell {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    background: var(--background);
    color: var(--ink);
  }

  /* Top bar */
  .credential-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    height: 3.5rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    flex-shrink: 0;
  }

  .credential-home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 150ms;
  }
  .credential-home-link:hover { color: var(--primary); }

  .credential-page-counter {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--muted-foreground);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .page-num { color: var(--primary); font-weight: 600; }

  /* Body: sidebar + content */
  .credential-body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* Sidebar */
  .credential-sidebar {
    width: 14rem;
    flex-shrink: 0;
    border-right: 1px solid var(--line);
    padding: 1.5rem 0;
    overflow-y: auto;
    background: var(--surface);
  }

  .sidebar-label {
    font-family: monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    padding: 0 1.25rem 0.75rem;
    opacity: 0.7;
  }

  .sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar-item {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.6rem 1.25rem;
    text-decoration: none;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    line-height: 1.4;
    transition: background 150ms, color 150ms;
    border-left: 2px solid transparent;
  }
  .sidebar-item:hover {
    background: var(--card);
    color: var(--ink);
  }
  .sidebar-item.active {
    color: var(--primary);
    border-left-color: var(--primary);
    background: var(--card);
    font-weight: 600;
  }

  .sidebar-num {
    font-family: monospace;
    font-size: 0.65rem;
    opacity: 0.5;
    flex-shrink: 0;
  }

  /* Main content area */
  .credential-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .credential-slide {
    flex: 1;
    overflow-y: auto;
    padding: 3rem 4rem;
    max-width: 56rem;
    width: 100%;
    margin: 0 auto;
  }

  .slide-label {
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 2rem;
    opacity: 0.85;
  }

  .slide-body {
    /* prose-content styles handle typography */
  }

  /* Bottom navigation */
  .credential-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.5rem;
    border-top: 1px solid var(--line);
    background: var(--surface);
    flex-shrink: 0;
    gap: 1rem;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted-foreground);
    transition: color 150ms;
    min-width: 8rem;
  }
  .nav-btn.nav-next { justify-content: flex-end; }
  .nav-btn:not(.disabled):hover { color: var(--primary); }
  .nav-btn.disabled { opacity: 0.3; cursor: default; }

  .nav-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 12rem;
  }

  .nav-dots {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: var(--muted-foreground);
    opacity: 0.3;
    transition: opacity 150ms, background 150ms;
    display: block;
  }
  .nav-dot.active {
    background: var(--primary);
    opacity: 1;
  }

  /* Mobile: hide sidebar, stack layout */
  @media (max-width: 768px) {
    .credential-sidebar {
      display: none;
    }

    .credential-slide {
      padding: 2rem 1.5rem;
    }

    .nav-label {
      display: none;
    }

    .nav-btn {
      min-width: auto;
    }
  }
</style>
