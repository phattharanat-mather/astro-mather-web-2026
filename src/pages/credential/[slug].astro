---
import { getCollection, render } from 'astro:content';
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import { siteConfig } from '@/data/site';

export async function getStaticPaths() {
  const allPages = await getCollection('credentialPages');
  const visible = allPages
    .filter(p => !p.data.hide)
    .sort((a, b) => a.id.localeCompare(b.id));

  return visible.map((page, i) => ({
    params: { slug: page.id.replace(/\/index$/, '') },
    props: {
      page,
      prev: visible[i - 1] ?? null,
      next: visible[i + 1] ?? null,
      current: i + 1,
      total: visible.length,
      all: visible.map(p => ({
        slug: p.id.replace(/\/index$/, ''),
        title: p.data.title,
      })),
    },
  }));
}

const { page, prev, next, current, total, all } = Astro.props;
const currentSlug = page.id.replace(/\/index$/, '');

const { Content } = await render(page);

const prevSlug = prev ? prev.id.replace(/\/index$/, '') : null;
const nextSlug = next ? next.id.replace(/\/index$/, '') : null;
---

<PresentationLayout
  title={`${page.data.title} — Credentials — ${siteConfig.name}`}
  description={`Credential presentation: ${page.data.title}`}
>
  <!-- Slide content renders inside the 16:9 canvas via default slot -->
  <Content />

  <!-- ── Control bar ─────────────────────────────────────────── -->
  <div slot="controls" class="pres-controls" role="toolbar" aria-label="Presentation controls">

    <!-- Left -->
    <div class="ctrl-left">
      <a href="/credential" class="ctrl-btn ctrl-back" aria-label="Back to credential index">← credential</a>
    </div>

    <!-- Center -->
    <div class="ctrl-center">
      {prevSlug ? (
        <a href={`/credential/${prevSlug}`} class="ctrl-btn ctrl-arrow" aria-label="Previous page">←</a>
      ) : (
        <span class="ctrl-btn ctrl-arrow disabled" aria-disabled="true">←</span>
      )}

      <span class="ctrl-counter">
        page <strong>{current}</strong>/{total}
      </span>

      <span class="ctrl-divider" aria-hidden="true">|</span>

      <button id="btn-view-all" class="ctrl-btn ctrl-view-all" type="button">
        view all pages
      </button>

      {nextSlug ? (
        <a href={`/credential/${nextSlug}`} class="ctrl-btn ctrl-arrow" aria-label="Next page">→</a>
      ) : (
        <span class="ctrl-btn ctrl-arrow disabled" aria-disabled="true">→</span>
      )}
    </div>

    <!-- Right (balance) -->
    <div class="ctrl-right" aria-hidden="true"></div>

  </div>

  <!-- ── Page list sheet + backdrop ─────────────────────────── -->
  <div slot="overlays">

    <div id="page-sheet" class="page-sheet" aria-hidden="true" role="dialog" aria-label="All pages">
      <div class="sheet-inner">
        <div class="sheet-handle" aria-hidden="true"></div>
        <div class="sheet-header">
          <p class="sheet-title">All Pages</p>
          <button id="btn-close-sheet" class="sheet-close" type="button" aria-label="Close page list">✕</button>
        </div>
        <ol class="sheet-grid">
          {all.map((item, i) => (
            <li>
              <a
                href={`/credential/${item.slug}`}
                class:list={['sheet-card', { active: item.slug === currentSlug }]}
              >
                <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="card-title">{item.title}</span>
                {item.slug === currentSlug && (
                  <span class="card-badge">current</span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div id="sheet-backdrop" class="sheet-backdrop" aria-hidden="true"></div>

  </div>

</PresentationLayout>

<script define:vars={{ prevSlug, nextSlug }}>
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft' && prevSlug) {
      window.location.href = `/credential/${prevSlug}`;
    }
    if (e.key === 'ArrowRight' && nextSlug) {
      window.location.href = `/credential/${nextSlug}`;
    }
    if (e.key === 'Escape') closeSheet();
  });

  const sheet = document.getElementById('page-sheet');
  const backdrop = document.getElementById('sheet-backdrop');

  function openSheet() {
    sheet.classList.add('open');
    backdrop.classList.add('open');
    sheet.setAttribute('aria-hidden', 'false');
  }
  function closeSheet() {
    sheet.classList.remove('open');
    backdrop.classList.remove('open');
    sheet.setAttribute('aria-hidden', 'true');
  }

  document.getElementById('btn-view-all').addEventListener('click', () => {
    sheet.classList.contains('open') ? closeSheet() : openSheet();
  });
  document.getElementById('btn-close-sheet').addEventListener('click', closeSheet);
  backdrop.addEventListener('click', closeSheet);
</script>

<style>
  /* ── Control bar ───────────────────────────────────────────── */
  .pres-controls {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 3rem;
    flex-shrink: 0;
    border-top: 1.5px solid var(--line-strong);
    background: var(--surface);
    padding: 0 1.5rem;
  }

  .ctrl-left { display: flex; align-items: center; }
  .ctrl-center { display: flex; align-items: center; gap: 1rem; }
  .ctrl-right { display: flex; align-items: center; justify-content: flex-end; }

  .ctrl-btn {
    display: inline-flex;
    align-items: center;
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted-foreground);
    transition: color 150ms;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }
  .ctrl-btn:not(.disabled):hover { color: var(--primary); }
  .ctrl-btn.disabled { opacity: 0.25; cursor: default; }

  .ctrl-back {
    letter-spacing: 0.06em;
  }

  .ctrl-arrow {
    font-size: 0.9rem;
    width: 2rem;
    justify-content: center;
  }

  .ctrl-counter {
    font-family: monospace;
    font-size: 0.7rem;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
  .ctrl-counter strong {
    color: var(--primary);
    font-weight: 700;
  }

  .ctrl-divider {
    color: var(--line-strong);
    font-size: 0.8rem;
    user-select: none;
  }

  .ctrl-view-all {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Page list sheet ───────────────────────────────────────── */
  .page-sheet {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--background);
    border-top: 1.5px solid var(--line-strong);
    transform: translateY(100%);
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
    max-height: 70dvh;
    display: flex;
    flex-direction: column;
  }
  .page-sheet.open { transform: translateY(0); }

  .sheet-inner {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    max-height: 70dvh;
  }

  .sheet-handle {
    width: 2.5rem;
    height: 0.25rem;
    background: var(--muted-foreground);
    border-radius: 9999px;
    opacity: 0.3;
    margin: 0.75rem auto 0;
    flex-shrink: 0;
  }

  .sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.5rem;
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }

  .sheet-title {
    font-family: monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin: 0;
  }

  .sheet-close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    padding: 0.25rem;
    line-height: 1;
    transition: color 150ms;
  }
  .sheet-close:hover { color: var(--ink); }

  .sheet-grid {
    list-style: none;
    margin: 0;
    padding: 1rem 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.625rem;
    overflow-y: auto;
  }

  .sheet-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.875rem 1rem;
    border: 1.5px solid var(--line);
    text-decoration: none;
    color: var(--muted-foreground);
    background: var(--card);
    transition: border-color 150ms, background 150ms;
    position: relative;
  }
  .sheet-card:hover,
  .sheet-card.active {
    border-color: var(--primary);
    background: var(--background);
  }

  .card-num {
    font-family: monospace;
    font-size: 0.65rem;
    opacity: 0.45;
  }

  .card-title {
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }

  .card-badge {
    font-family: monospace;
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
    margin-top: 0.25rem;
  }

  /* ── Backdrop ──────────────────────────────────────────────── */
  .sheet-backdrop {
    position: fixed;
    inset: 0;
    z-index: 49;
    background: oklch(0 0 0 / 30%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms;
  }
  .sheet-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 640px) {
    .sheet-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
