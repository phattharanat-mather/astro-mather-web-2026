---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import { siteConfig } from '@/data/site';

const nextSlug = '001-introduction';
---

<PresentationLayout
  title={`Cover — Credentials — ${siteConfig.name}`}
  description="The Mather credential presentation."
>
  <!-- ── Slide content ──────────────────────────────────────── -->
  <div class="cover-slide">

    <p class="cover-eyebrow">Solution &amp; Technology</p>

    <div class="cover-body">
      <p class="cover-wordmark">The Mather</p>
      <p class="cover-tagline">{siteConfig.tagline}</p>
    </div>

    <div class="cover-footer">
      <span>Credential 2024–2025 &nbsp;·&nbsp; All Rights Reserved.</span>
      <span>© 2024 The Mather Co.,Ltd.</span>
    </div>

  </div>

  <!-- ── Control bar ────────────────────────────────────────── -->
  <div slot="controls" class="pres-controls" role="toolbar" aria-label="Presentation controls">

    <div class="ctrl-left">
      <a href="/credential" class="ctrl-btn ctrl-back">← credential</a>
    </div>

    <div class="ctrl-center">
      <span class="ctrl-btn ctrl-arrow disabled" aria-disabled="true">←</span>
      <span class="ctrl-counter">cover</span>
      <a href={`/credential/${nextSlug}`} class="ctrl-btn ctrl-arrow" aria-label="Next page">→</a>
    </div>

    <div class="ctrl-right" aria-hidden="true"></div>

  </div>

</PresentationLayout>

<style>
  /* ── Cover layout ──────────────────────────────────────────── */
  .cover-slide {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: 0;
  }

  .cover-eyebrow {
    font-family: monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin: 0;
    padding: 2.5rem 3.5rem 0;
  }

  /* Center body — vertically fills remaining space */
  .cover-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.25rem;
    padding: 2rem 4rem;
  }

  .cover-wordmark {
    font-family: 'Instrument Serif', ui-serif, Georgia, serif;
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0;
  }

  .cover-tagline {
    font-size: clamp(0.8rem, 1.1vw, 1rem);
    color: var(--muted-foreground);
    letter-spacing: 0.03em;
    max-width: 48ch;
    line-height: 1.6;
    margin: 0;
  }

  /* Footer strip */
  .cover-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 3.5rem;
    border-top: 1px solid var(--line);
    font-family: monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  /* ── Control bar (mirrors [slug].astro) ───────────────────── */
  .pres-controls {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 3rem;
    flex-shrink: 0;
    border-top: 1.5px solid var(--line-strong);
    background: var(--surface);
    padding: 0 1.5rem;
  }

  .ctrl-left  { display: flex; align-items: center; }
  .ctrl-center { display: flex; align-items: center; gap: 1rem; }
  .ctrl-right { display: flex; align-items: center; justify-content: flex-end; }

  .ctrl-btn {
    display: inline-flex;
    align-items: center;
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted-foreground);
    transition: color 150ms;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }
  .ctrl-btn:not(.disabled):hover { color: var(--primary); }
  .ctrl-btn.disabled { opacity: 0.25; cursor: default; }

  .ctrl-arrow {
    font-size: 0.9rem;
    width: 2rem;
    justify-content: center;
  }

  .ctrl-counter {
    font-family: monospace;
    font-size: 0.7rem;
    color: var(--muted-foreground);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
