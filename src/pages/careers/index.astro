---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import ContactFooter from '@/components/home/ContactFooter.astro';
import PositionCard from '@/components/career/PositionCard.astro';
import OpenApplication from '@/components/career/OpenApplication.astro';
import { siteConfig, nav, footer, careers } from '@/data/site';

const positionsCollection = await getCollection('openPositions');
const positions = positionsCollection
  .filter((p) => p.data.open)
  .sort((a, b) => b.data.postedDate.getTime() - a.data.postedDate.getTime())
  .map((p) => ({
    slug: p.id.replace(/\/index$/, ''),
    title: p.data.title,
    department: p.data.department,
    location: p.data.location,
    type: p.data.type,
    salary: p.data.salary,
    summary: p.data.summary,
    postedDate: p.data.postedDate.toISOString().split('T')[0],
  }));
---

<Layout
  title={`Careers — ${siteConfig.name}`}
  description="Join The Mather. Explore open positions across engineering, data, and AI."
>
  <Nav data={nav} />

  <main class="pt-14">
    <!-- Page header -->
    <div class="border-b border-[var(--line)] py-20">
      <div class="max-w-7xl mx-auto px-6 lg:px-8" data-reveal>
        <p class="font-mono text-xs tracking-widest uppercase text-[var(--primary)] mb-4">
          Work With Us
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight" style="color: var(--ink);">
          Open Positions
        </h1>
        <p class="mt-4 text-[var(--muted-foreground)] leading-relaxed max-w-xl">
          We are a small, senior team building AI and data systems for real businesses.
          If you want ownership and variety, we would love to hear from you.
        </p>
      </div>
    </div>

    <!-- Positions list -->
    <section class="py-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        {positions.length === 0 ? (
          <p class="font-mono text-sm text-[var(--muted-foreground)]">
            No open positions right now — check back soon.
          </p>
        ) : (
          <div class="flex flex-col divide-y divide-[var(--line)] border border-[var(--line)]">
            {positions.map((position, i) => (
              <PositionCard {...position} index={i} />
            ))}
          </div>
        )}
      </div>
    </section>

    <OpenApplication email={careers.email} />
  </main>

  <ContactFooter data={footer} />
</Layout>
