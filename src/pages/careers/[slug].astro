---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import ContactFooter from '@/components/home/ContactFooter.astro';
import HowToApply from '@/components/career/HowToApply.astro';
import { siteConfig, nav, footer, careers } from '@/data/site';

export async function getStaticPaths() {
  const positions = await getCollection('openPositions');
  return positions.map((position) => ({
    params: { slug: position.id.replace(/\/index$/, '') },
    props: { position },
  }));
}

const { position } = Astro.props;
const { Content } = await render(position);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  });
}
---

<Layout
  title={`${position.data.title} — Careers — ${siteConfig.name}`}
  description={position.data.summary}
>
  <Nav data={nav} />

  <main class="pt-14">
    <!-- Role header -->
    <div class="border-b border-[var(--line)] py-20">
      <div class="max-w-3xl mx-auto px-6 lg:px-8" data-reveal>
        <a
          href="/careers"
          class="
            inline-flex items-center gap-2 mb-10
            font-mono text-xs tracking-widest uppercase
            text-[var(--muted-foreground)] hover:text-[var(--primary)]
            transition-colors duration-150
          "
        >
          <span aria-hidden="true">←</span>
          All positions
        </a>

        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="font-mono text-xs tracking-widest uppercase text-[var(--primary)]">
            {position.data.department}
          </span>
          <span class="font-mono text-xs text-[var(--muted-foreground)]">·</span>
          <span class="font-mono text-xs tracking-wide text-[var(--muted-foreground)]">
            {position.data.type}
          </span>
          <span class="font-mono text-xs text-[var(--muted-foreground)]">·</span>
          <span class="font-mono text-xs tracking-wide text-[var(--muted-foreground)]">
            {position.data.location}
          </span>
          {position.data.salary && (
            <>
              <span class="font-mono text-xs text-[var(--muted-foreground)]">·</span>
              <span class="font-mono text-xs tracking-wide text-[var(--foreground)]">
                {position.data.salary}
              </span>
            </>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight" style="color: var(--ink);">
          {position.data.title}
        </h1>
        <p class="mt-4 text-lg text-[var(--muted-foreground)] leading-relaxed">
          {position.data.summary}
        </p>

        <p class="mt-6 font-mono text-xs text-[var(--muted-foreground)]">
          Posted {formatDate(position.data.postedDate)}
        </p>
      </div>
    </div>

    <!-- Role body -->
    <article class="py-20">
      <div
        class="
          max-w-3xl mx-auto px-6 lg:px-8
          prose prose-neutral dark:prose-invert
          prose-headings:tracking-tight
          prose-a:text-[var(--primary)] prose-a:no-underline hover:prose-a:underline
          prose-hr:border-[var(--line)]
          prose-code:text-[var(--primary)] prose-code:before:content-none prose-code:after:content-none
          prose-ul:text-[var(--muted-foreground)] prose-li:marker:text-[var(--primary)]
          [--tw-prose-body:var(--muted-foreground)]
          [--tw-prose-headings:var(--ink)]
          [--tw-prose-bold:var(--ink)]
        "
        data-reveal
      >
        <Content />
      </div>
    </article>

    <HowToApply email={careers.email} positionTitle={position.data.title} />
  </main>

  <ContactFooter data={footer} />
</Layout>
