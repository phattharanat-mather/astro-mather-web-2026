---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import ContactFooter from '@/components/home/ContactFooter.astro';
import { siteConfig, nav, footer } from '@/data/site';
---

<Layout
  title={`Storytelling Credential — ${siteConfig.name}`}
  description="An interactive, scroll-driven credential deck — The Mather's story, services, and portfolio in one experience."
>
  <Nav data={nav} />

  <main class="pt-14">
    <!-- Header -->
    <div class="border-b border-[var(--line)] py-20">
      <div class="max-w-3xl mx-auto px-6 lg:px-8" data-reveal>
        <a
          href="/#platform"
          class="
            inline-flex items-center gap-2 mb-10
            font-mono text-xs tracking-widest uppercase
            text-[var(--muted-foreground)] hover:text-[var(--primary)]
            transition-colors duration-150
          "
        >
          <span aria-hidden="true">←</span>
          All projects
        </a>

        <div class="flex flex-wrap gap-2 mb-4">
          <span class="font-mono text-xs tracking-widest uppercase text-[var(--primary)]">web</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight" style="color: var(--ink);">
          Storytelling Credential
        </h1>

        <p class="mt-4 text-[var(--muted-foreground)] leading-relaxed max-w-xl">
          An interactive, scroll-driven credential deck — The Mather's story, services, and portfolio in one experience.
        </p>

        <a
          href="/storytelling/credential"
          class="
            mt-6 inline-flex items-center gap-2
            font-mono text-xs tracking-widest uppercase
            text-[var(--primary)] hover:opacity-70
            transition-opacity duration-150
          "
          target="_blank"
          rel="noopener"
        >
          Open full screen <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Embedded credential via iframe -->
    <div class="w-full border-b border-[var(--line)]" data-reveal>
      <iframe
        src="/storytelling/credential"
        title="Storytelling Credential"
        class="w-full"
        style="height: 100vh; border: none; display: block;"
        loading="lazy"
      />
    </div>
  </main>

  <ContactFooter data={footer} />
</Layout>
