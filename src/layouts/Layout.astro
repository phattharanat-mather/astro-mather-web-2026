---
import '../styles/globals.css';
import { SEO } from 'astro-seo';
import { siteConfig } from '../data/site';
import SplashModal from '../components/splash/SplashModal.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;
---

<html lang="en" data-color-preset="void">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05070f" />
    <SEO
      title={title}
      description={description}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: siteConfig.url + siteConfig.seo.ogImage,
          url: canonicalUrl,
        },
        optional: {
          description,
          locale: siteConfig.seo.locale,
          siteName: siteConfig.name,
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: siteConfig.seo.twitterHandle,
        title,
        description,
        image: siteConfig.url + siteConfig.seo.ogImage,
      }}
      extend={{
        meta: [
          { name: "keywords", content: siteConfig.seo.keywords.join(", ") },
        ],
      }}
    />

    <!-- Runs synchronously before first paint — prevents theme flash -->
    <script is:inline>
      (function () {
        var preset = localStorage.getItem('color-preset') || 'void';
        var darkPresets = ['cosmos', 'void', 'blackhole', 'pulsar', 'nebula'];
        document.documentElement.dataset.colorPreset = preset;
        if (darkPresets.indexOf(preset) !== -1) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>

  <body style={siteConfig.greyscaleFilter.enable ? `filter: grayscale(${siteConfig.greyscaleFilter.value})` : undefined}>
    <SplashModal />
    <slot />

    <!-- Scroll reveal observer -->
    <script is:inline>
      (function () {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
              }
            });
          },
          { threshold: 0.08 }
        );
        document.querySelectorAll('[data-reveal]').forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
