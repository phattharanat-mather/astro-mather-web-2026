---
/**
 * Canvas — slide wrapper for credential-pages MDX content.
 *
 * Slots
 *   default   — body content (always present)
 *   header    — optional header region (eyebrow + title)
 *   footer    — optional footer strip
 *
 * Props
 *   layout    — 'default' | 'split' | 'cover'
 *               default : stacked header → body
 *               split   : body split into two equal columns
 *               cover   : full-bleed centered title card
 */

interface Props {
  layout?: 'default' | 'split' | 'cover';
  class?: string;
}

const { layout = 'default', class: className } = Astro.props;

const hasHeader = Astro.slots.has('header');
const hasFooter = Astro.slots.has('footer');
---

<section class:list={['cred-canvas', `layout-${layout}`, className]}>

  {hasHeader && (
    <header class="cred-header">
      <slot name="header" />
    </header>
  )}

  <div class="cred-body">
    <slot />
  </div>

  {hasFooter && (
    <footer class="cred-footer">
      <slot name="footer" />
    </footer>
  )}

</section>

<style>
  /* ── Shell ──────────────────────────────────────────────────── */
  .cred-canvas {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0;
  }

  /* ── Header region ──────────────────────────────────────────── */
  .cred-header {
    flex-shrink: 0;
    padding-bottom: 1.75rem;
    border-bottom: 1.5px solid var(--line);
    margin-bottom: 2rem;
  }

  /* ── Body region ────────────────────────────────────────────── */
  .cred-body {
    flex: 1;
    min-height: 0;
  }

  /* ── Footer region ──────────────────────────────────────────── */
  .cred-footer {
    flex-shrink: 0;
    padding-top: 1.5rem;
    border-top: 1.5px solid var(--line);
    margin-top: 1.75rem;
    font-family: monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ── Layout: split ──────────────────────────────────────────── */
  .layout-split .cred-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  /* ── Layout: cover ──────────────────────────────────────────── */
  .layout-cover {
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
  }
  .layout-cover .cred-header {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 1rem;
  }
  .layout-cover .cred-body {
    flex: unset;
  }

  @media (max-width: 640px) {
    .layout-split .cred-body {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
