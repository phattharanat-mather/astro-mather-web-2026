---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { FounderQuoteData } from '@/content-definition/home';

interface Props {
  data: FounderQuoteData;
  quotes: CollectionEntry<'founderQuotes'>[];
}

const { data, quotes } = Astro.props;

const sorted = quotes.sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  sorted.map(async (q) => {
    const { Content } = await render(q);
    return { entry: q, Content };
  })
);
---

<section id="testimonials" class="py-24 border-b border-[var(--line)]">

  <!-- Tagline block -->
  <div
    class="
      max-w-7xl mx-auto px-6 lg:px-8
      mb-16 pb-16 border-b border-[var(--line)]
      grid lg:grid-cols-2 gap-12 items-center
    "
    data-reveal
  >
    <div>
      <p class="font-mono text-xs tracking-widest uppercase text-[var(--muted-foreground)] mb-4">
        {data.heading}
      </p>
      <h2
        class="text-2xl sm:text-3xl font-black tracking-tighter leading-snug"
        style="color: var(--primary);"
      >
        {data.tagline}
      </h2>
      <p class="mt-4 text-[var(--muted-foreground)] leading-relaxed">
        {data.body}
      </p>
    </div>

    <div class="flex lg:justify-end">
      <a
        href={data.cta.href}
        download
        class="
          inline-flex items-center gap-3
          px-5 py-3 rounded-sm
          border border-[var(--primary)]
          font-sans text-sm font-medium
          text-[var(--primary)]
          hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)]
          transition-colors duration-150
        "
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1v8M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {data.cta.label}
      </a>
    </div>
  </div>

  <!-- Marquee -->
  <div class="marquee-track overflow-hidden" aria-label="Founder quotes">
    <div class="marquee-inner flex gap-8">
      {[...rendered, ...rendered, ...rendered].map(({ entry, Content }, i) => (
        <figure
          class="
            marquee-card
            shrink-0 w-[min(80vw,480px)]
            border border-[var(--line)]
            bg-[var(--surface)]
            rounded-sm p-8
          "
          aria-hidden={i >= rendered.length ? 'true' : undefined}
        >
          <blockquote class="relative mb-8">
            <span
              aria-hidden="true"
              class="block font-mono text-5xl leading-none select-none opacity-20 mb-4"
              style="color: var(--primary);"
            >"</span>
            <p
              class="text-base sm:text-lg font-medium leading-relaxed tracking-tight"
              style="color: var(--ink);"
            >
              <Content />
            </p>
          </blockquote>
          <figcaption class="flex items-center gap-3">
            {entry.data.image && (
              <Image
                src={entry.data.image}
                alt={entry.data.name}
                width={40}
                height={40}
                class="w-10 h-10 rounded-full object-cover object-top shrink-0"
              />
            )}
            <div>
              <p class="font-semibold text-sm" style="color: var(--ink);">{entry.data.name}</p>
              <p class="font-mono text-xs tracking-widest uppercase text-[var(--muted-foreground)] mt-0.5">
                {entry.data.role}
              </p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee-inner {
    animation: marquee-scroll 30s linear infinite;
    width: max-content;
  }

  .marquee-track:hover .marquee-inner {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-100% / 3)); }
  }
</style>
