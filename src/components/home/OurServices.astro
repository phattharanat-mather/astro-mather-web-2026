---
import type { OurServicesData } from '@/content-definition/home';

interface Props {
  data: OurServicesData;
}

const { data } = Astro.props;
---

<section id="service" class="py-24 border-b border-[var(--line)]">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Section header -->
    <div class="mb-16 grid lg:grid-cols-2 gap-8 items-end" data-reveal>
      <h2
        class="text-3xl sm:text-4xl font-bold tracking-tight"
        style="color: var(--ink);"
      >
        {data.heading}
      </h2>
      <p class="text-[var(--muted-foreground)] leading-relaxed lg:text-right">
        {data.intro}
      </p>
    </div>

    <!-- Service list -->
    <ul class="list-none m-0 p-0 grid sm:grid-cols-2 gap-x-12">
      {data.items.map((item, i) => (
        <li
          class="
            group
            border-t border-[var(--line)]
          "
          data-reveal
          style={`transition-delay: ${i * 60}ms`}
        >
          <div
            class="
              py-8
              hover:bg-[var(--surface)]
              transition-colors duration-150
              px-4 -mx-4 rounded-sm
            "
          >
            <!-- Title + description -->
            <div>
              <h3
                class="text-lg font-semibold tracking-tight mb-2"
                style="color: var(--ink);"
              >
                {item.title}
              </h3>
              <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
                {item.body}
              </p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
