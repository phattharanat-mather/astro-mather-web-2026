---
import type { OurServicesData } from '@/content-definition/home';

interface Props {
  data: OurServicesData;
}

const { data } = Astro.props;
---

<section id="service" class="py-24 border-b border-[var(--line)]">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Section header -->
    <div class="mb-16 grid lg:grid-cols-2 gap-8 items-end" data-reveal>
      <h2
        class="text-3xl sm:text-4xl font-bold tracking-tight"
        style="color: var(--ink);"
      >
        {data.heading}
      </h2>
      <p class="text-[var(--muted-foreground)] leading-relaxed lg:text-right">
        {data.intro}
      </p>
    </div>

    <!-- Service list -->
    <ul class="list-none m-0 p-0">
      {data.items.map((item, i) => (
        <li
          class="
            group
            border-t border-[var(--line)]
            last:border-b
          "
          data-reveal
          style={`transition-delay: ${i * 60}ms`}
        >
          <div
            class="
              py-8
              grid grid-cols-[4rem_1fr] lg:grid-cols-[6rem_1fr_auto] gap-x-6 gap-y-2
              items-start
              hover:bg-[var(--surface)]
              transition-colors duration-150
              px-4 -mx-4 rounded-sm
            "
          >
            <!-- Index -->
            <p
              class="
                font-mono text-xs tracking-widest pt-1
                text-[var(--muted-foreground)]
                group-hover:text-[var(--primary)]
                transition-colors duration-150
              "
            >
              / {item.index}
            </p>

            <!-- Title + description -->
            <div>
              <h3
                class="text-lg font-semibold tracking-tight mb-2"
                style="color: var(--ink);"
              >
                {item.title}
              </h3>
              <p class="text-sm text-[var(--muted-foreground)] leading-relaxed max-w-2xl">
                {item.description}
              </p>
            </div>

            <!-- Arrow (desktop) -->
            <span
              aria-hidden="true"
              class="
                hidden lg:block
                font-mono text-sm
                text-[var(--line-strong)]
                group-hover:text-[var(--primary)]
                group-hover:translate-x-1
                transition-all duration-150
                self-center
              "
            >
              →
            </span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
