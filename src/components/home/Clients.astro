---
import type { ClientsData } from "@/content-definition/home";

interface Props {
    data: ClientsData;
}

const { data } = Astro.props;

// Abstract geometric SVG marks — one per client slot
const svgPaths: string[] = [
    // hexagon
    `<polygon points="10,2 17.3,6 17.3,14 10,18 2.7,14 2.7,6" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
    // bridge arcs
    `<path d="M2 14 Q6 8 10 14 Q14 8 18 14" fill="none" stroke="currentColor" stroke-width="1.5"/><line x1="2" y1="14" x2="18" y2="14" stroke="currentColor" stroke-width="1.5"/>`,
    // orbital ring
    `<circle cx="10" cy="10" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><ellipse cx="10" cy="10" rx="8" ry="4" transform="rotate(-30 10 10)" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
    // sphere with latitude
    `<circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2.5 10 Q6 14 10 10 Q14 6 17.5 10" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
    // pulse waveform
    `<polyline points="2,10 5,10 7,5 9,15 11,7 13,13 15,10 18,10" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
    // cloud arc
    `<path d="M5 14 Q4.5 9 9 9 Q10 5.5 14 6.5 Q18 7 17.5 11 Q19.5 11 19 14 Z" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
    // chevron V
    `<polyline points="3,5 10,15 17,5" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
    // meridian cross
    `<line x1="10" y1="2" x2="10" y2="18" stroke="currentColor" stroke-width="1.5"/><line x1="3" y1="10" x2="17" y2="10" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="2.5" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
    // connected nodes
    `<circle cx="10" cy="10" r="2" fill="currentColor"/><circle cx="4" cy="6" r="1.5" fill="currentColor"/><circle cx="16" cy="6" r="1.5" fill="currentColor"/><circle cx="4" cy="14" r="1.5" fill="currentColor"/><circle cx="16" cy="14" r="1.5" fill="currentColor"/><line x1="10" y1="10" x2="4" y2="6" stroke="currentColor" stroke-width="1"/><line x1="10" y1="10" x2="16" y2="6" stroke="currentColor" stroke-width="1"/><line x1="10" y1="10" x2="4" y2="14" stroke="currentColor" stroke-width="1"/><line x1="10" y1="10" x2="16" y2="14" stroke="currentColor" stroke-width="1"/>`,
    // lens / eye
    `<path d="M2 10 Q10 3 18 10 Q10 17 2 10Z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="2.5" fill="none" stroke="currentColor" stroke-width="1.5"/>`,
];

const clients = data.items.map((item, i) => ({
    name: item.name,
    svg: svgPaths[i % svgPaths.length],
}));

const row1 = clients.slice(0, 5);
const row2 = clients.slice(5);

// 4× repetition for seamless infinite scroll
const r1 = [...row1, ...row1, ...row1, ...row1];
const r2 = [...row2, ...row2, ...row2, ...row2];
---

<section class="py-24 border-b border-[var(--line)] overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="mb-12" data-reveal>
            <h2
                class="text-3xl sm:text-4xl font-bold tracking-tight"
                style="color: var(--ink);"
            >
                {data.heading}
            </h2>
            <p class="mt-2 text-[var(--muted-foreground)]">{data.intro}</p>
        </div>
    </div>

    <div class="clients-marquee">
        <!-- Row 1: scrolls left -->
        <div class="marquee-track marquee-left">
            {
                r1.map((c) => (
                    <div class="client-chip">
                        <svg
                            viewBox="0 0 20 20"
                            width="18"
                            height="18"
                            aria-hidden="true"
                            set:html={c.svg}
                        />
                        <span>{c.name}</span>
                    </div>
                ))
            }
        </div>

        <!-- Row 2: scrolls right -->
        <div class="marquee-track marquee-right">
            {
                r2.map((c) => (
                    <div class="client-chip">
                        <svg
                            viewBox="0 0 20 20"
                            width="18"
                            height="18"
                            aria-hidden="true"
                            set:html={c.svg}
                        />
                        <span>{c.name}</span>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style is:global>
    @keyframes marquee-left {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }
    @keyframes marquee-right {
        from {
            transform: translateX(-50%);
        }
        to {
            transform: translateX(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee-left,
        .marquee-right {
            animation: none;
        }
    }
</style>

<style>
    .clients-marquee {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .marquee-track {
        display: flex;
        gap: 12px;
        width: max-content;
        padding: 4px 0;
        position: relative;
    }

    .marquee-left {
        animation: marquee-left 28s linear infinite;
    }
    .marquee-right {
        animation: marquee-right 32s linear infinite;
    }

    .client-chip {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 18px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        white-space: nowrap;
        cursor: default;
        color: var(--muted-foreground);
        transition:
            border-color 200ms ease-out,
            background 200ms ease-out;
    }

    .client-chip:hover {
        border-color: var(--line-strong, var(--primary));
        background: var(--background);
    }

    .client-chip svg {
        flex-shrink: 0;
    }

    .client-chip span {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }
</style>
