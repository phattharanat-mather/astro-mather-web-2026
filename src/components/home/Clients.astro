---
import { Image } from 'astro:assets';
import type { ClientsData } from "@/content-definition/home";

interface Props {
    data: ClientsData;
}

const { data } = Astro.props;

const clients = data.items.filter((item) => item.logo);

const row1 = clients.slice(0, Math.ceil(clients.length / 2));
const row2 = clients.slice(Math.ceil(clients.length / 2));

// 4× repetition for seamless infinite scroll
const r1 = [...row1, ...row1, ...row1, ...row1];
const r2 = [...row2, ...row2, ...row2, ...row2];
---

<section class="py-24 border-b border-[var(--line)] overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="mb-12" data-reveal>
            <h2
                class="text-3xl sm:text-4xl font-bold tracking-tight"
                style="color: var(--ink);"
            >
                {data.heading}
            </h2>
            <p class="mt-2 text-[var(--muted-foreground)]">{data.intro}</p>
        </div>
    </div>

    <div class="clients-marquee">
        <!-- Row 1: scrolls left -->
        <div class="marquee-track marquee-left">
            {
                r1.map((c) => (
                    <div class="client-card">
                        <div class="logo-wrap">
                            <Image
                                src={c.logo!}
                                alt={c.name ?? ""}
                                height={32}
                                class={`logo-img${c.logoDark ? ' logo-light' : ''}`}
                            />
                            {c.logoDark && (
                                <Image
                                    src={c.logoDark}
                                    alt={c.name ?? ""}
                                    height={32}
                                    class="logo-img logo-dark"
                                />
                            )}
                        </div>
                        <span class="client-name">{c.name}</span>
                    </div>
                ))
            }
        </div>

        <!-- Row 2: scrolls right -->
        <div class="marquee-track marquee-right">
            {
                r2.map((c) => (
                    <div class="client-card">
                        <div class="logo-wrap">
                            <Image
                                src={c.logo!}
                                alt={c.name ?? ""}
                                height={32}
                                class={`logo-img${c.logoDark ? ' logo-light' : ''}`}
                            />
                            {c.logoDark && (
                                <Image
                                    src={c.logoDark}
                                    alt={c.name ?? ""}
                                    height={32}
                                    class="logo-img logo-dark"
                                />
                            )}
                        </div>
                        <span class="client-name">{c.name}</span>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style is:global>
    @keyframes marquee-left {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }
    @keyframes marquee-right {
        from {
            transform: translateX(-50%);
        }
        to {
            transform: translateX(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee-left,
        .marquee-right {
            animation: none;
        }
    }
</style>

<style>
    .clients-marquee {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .marquee-track {
        display: flex;
        gap: 12px;
        width: max-content;
        padding: 4px 0;
    }

    .marquee-left {
        animation: marquee-left 32s linear infinite;
    }
    .marquee-right {
        animation: marquee-right 38s linear infinite;
    }

    .client-card {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 16px 24px;
        width: 140px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        white-space: nowrap;
        cursor: default;
        transition:
            border-color 200ms ease-out,
            background 200ms ease-out;
    }

    .client-card:hover {
        border-color: var(--line-strong, var(--primary));
        background: var(--background);
    }

    .logo-wrap {
        width: 100%;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .logo-img {
        max-height: 32px;
        width: auto;
        max-width: 96px;
        object-fit: contain;
        filter: grayscale(1) opacity(0.6);
        transition: filter 200ms ease-out;
    }

    .client-card:hover .logo-img {
        filter: grayscale(0) opacity(1);
    }

    /* Dark-mode logo swap: show logo-dark only in dark theme */
    :global(.dark) .logo-light { display: none; }
    .logo-dark { display: none; }
    :global(.dark) .logo-dark { display: block; }

    .client-name {
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted-foreground);
    }
</style>
