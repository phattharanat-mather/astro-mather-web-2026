---
import type { HeroData } from '@/content-definition/home';
import { HeroSignal } from '@/components/home/ui/HeroSignal';
import { VortexBackground } from '@/components/home/ui/VortexBackground';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
---

<!--
  Variant 2 always renders on a cosmos-dark canvas.
  The vortex uses additive glow compositing which requires darkness.
  Text colours are pinned to the cosmos-dark palette via CSS variable
  overrides so the hero is legible on any page theme.
  The scrim fades the canvas to var(--background) which resolves from
  the page scope (not overridden here), giving a clean transition into
  whatever theme is active.
-->
<section
  id="welcome"
  class="
    relative min-h-svh flex flex-col justify-center
    pt-14 pb-16 px-6
    border-b border-[var(--line)]
    overflow-hidden
  "
  style="
    --foreground:         oklch(0.93 0.025 272);
    --muted-foreground:   oklch(0.55 0.055 258);
    --primary:            oklch(0.58 0.26 272);
    --headline2:          oklch(0.82 0.14 200);
    --line:               oklch(1 0 0 / 8%);
    --grad:               linear-gradient(90deg, oklch(0.58 0.26 272), oklch(0.67 0.22 350));
  "
>
  <!-- Vortex background — violet-cyan particle field, full height -->
  <div
    aria-hidden="true"
    class="absolute inset-0 overflow-hidden"
  >
    <VortexBackground
      baseHue={210}
      particleCount={500}
      rangeY={800}
      rangeSpeed={1.2}
      client:only="react"
    />
  </div>

  <!-- Bottom fade scrim — blends canvas into the page background -->
  <div
    aria-hidden="true"
    class="absolute bottom-0 left-0 right-0 h-40 z-10 pointer-events-none"
    style="background: linear-gradient(to bottom, transparent 0%, var(--background) 100%);"
  ></div>

  <div class="relative z-20 max-w-7xl mx-auto w-full lg:px-8">

    <!-- Company name -->
    <h1
      class="text-6xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-[var(--foreground)] mb-2 hero-item"
      style="--delay: 100ms"
    >
      {data.headline}
    </h1>

    <!-- Gradient accent line — scans in from left -->
    <div
      aria-hidden="true"
      class="mt-2 mb-8 h-px w-24 hero-line"
      style="--delay: 290ms; background: var(--grad);"
    ></div>

    <!-- Subheadline -->
    <p
      class="
        text-lg sm:text-xl max-w-xl leading-relaxed
        text-[var(--muted-foreground)]
        hero-item
      "
      style="--delay: 410ms"
    >
      {data.subheadline}
    </p>

    <!-- 4M + methodology morph — grouped signal below the tagline -->
    <HeroSignal tags={data.methodologyTags} delay="580ms" client:load />

  </div>

  <!-- Bottom readout strip — instrument panel metadata -->
  <div
    class="absolute bottom-0 left-0 right-0 z-20 border-t border-[var(--line)] px-6 lg:px-14 hero-item"
    style="--delay: 900ms"
  >
    <div class="max-w-7xl mx-auto py-3 flex items-center justify-between">
      <span class="font-mono text-xs tracking-widest uppercase text-[var(--muted-foreground)]">
        Bangkok · Thailand
      </span>
      <span class="font-mono text-xs tracking-widest uppercase text-[var(--muted-foreground)] flex items-center gap-2">
        Scroll
        <svg width="10" height="14" viewBox="0 0 10 14" fill="none" aria-hidden="true" class="animate-bounce opacity-60">
          <path d="M5 1v12M1 9l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </div>
</section>
