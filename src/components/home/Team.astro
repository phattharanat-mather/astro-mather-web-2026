---
import type { TeamData } from '@/content-definition/home';

interface Props {
  data: TeamData;
}

const { data } = Astro.props;
---

<section id="team" class="py-24 border-b border-[var(--line)] bg-[var(--surface)]">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <div class="mb-16" data-reveal>
      <h2
        class="text-3xl sm:text-4xl font-bold tracking-tight mb-3"
        style="color: var(--ink);"
      >
        {data.heading}
      </h2>
      <p class="text-[var(--muted-foreground)] leading-relaxed max-w-xl">
        {data.intro}
      </p>
    </div>

    <div class="border-t border-[var(--line)]">
      {data.disciplines.map((discipline) => (
        <div
          class="discipline-row flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-0 py-6 border-b border-[var(--line)] transition-colors duration-[250ms]"
          data-reveal
        >
          <span class="font-mono text-xs tracking-widest uppercase text-[var(--muted-foreground)] sm:w-16 shrink-0">
            / {discipline.index}
          </span>
          <p class="text-sm font-semibold sm:w-64 shrink-0" style="color: var(--ink);">
            {discipline.name}
          </p>
          <p class="text-sm text-[var(--muted-foreground)] leading-relaxed">
            {discipline.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .discipline-row:hover {
    background: var(--muted);
  }
</style>
