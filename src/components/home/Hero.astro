---
import type { HeroData } from '@/content-definition/home';
import { HeroSignal } from '@/components/home/HeroSignal';
// Hero background options — swap the active import to change the background:
// import { IsoWireframe as HeroBg }  from '@/components/home/hero-background/IsoWireframe';
// import { LiquidMetalBg as HeroBg } from '@/components/home/hero-background/LiquidMetalBg';
// import { DotGridBg as HeroBg }     from '@/components/home/hero-background/DotGridBg';
// import { NeuroNoiseBg as HeroBg }  from '@/components/home/hero-background/NeuroNoiseBg';
import { Shader3Bg as HeroBg }     from '@/components/home/hero-background/Shader3Bg';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
---

<section
  id="welcome"
  class="
    relative min-h-svh flex flex-col justify-center
    pt-14 pb-24 px-6
    border-b border-[var(--line)]
    overflow-hidden
  "
>
  <!-- Hero background — swap the import above to change the effect -->
  <div
    aria-hidden="true"
    class="absolute inset-0 pointer-events-none"
    style="opacity: var(--hero-bg-opacity, 0.38); mask-image: radial-gradient(ellipse 90% 80% at 60% 50%, black 20%, transparent 85%);"
  >
    <HeroBg client:only="react" />
  </div>

  <div class="relative z-10 max-w-7xl mx-auto w-full lg:px-8">

    <!-- Company name -->
    <h1
      class="text-6xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-[var(--foreground)] mb-2 hero-item"
      style="--delay: 100ms"
    >
      {data.headline}
    </h1>

    <!-- Gradient accent line — scans in from left -->
    <div
      aria-hidden="true"
      class="mt-2 mb-8 h-px w-24 hero-line"
      style="--delay: 290ms; background: var(--grad);"
    ></div>

    <!-- Subheadline -->
    <p
      class="
        text-lg sm:text-xl max-w-xl leading-relaxed
        text-[var(--muted-foreground)]
        hero-item
      "
      style="--delay: 410ms"
    >
      {data.subheadline}
    </p>

    <!-- 4M + methodology morph — grouped signal below the tagline -->
    <HeroSignal tags={data.methodologyTags} delay="580ms" client:load />


  </div>
</section>
