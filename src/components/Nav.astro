---
import { ThemeSwitcher } from './ThemeSwitcher';
import type { NavData } from '@/content-definition/home';

interface Props {
  data: NavData;
}

const { data } = Astro.props;
---

<header
  id="site-nav"
  class="
    fixed top-0 inset-x-0 z-50
    border-b border-[var(--line)]
    bg-[var(--background)]/80 backdrop-blur-md
    transition-colors duration-150
    hero-nav
  "
>
  <nav
    class="
      max-w-7xl mx-auto px-6 lg:px-8
      h-14 flex items-center justify-between gap-8
    "
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a href="/" class="shrink-0 flex items-center" aria-label="The Mather home">
      {data.logos.map((logo) => (
        <img
          src={logo.path}
          alt="The Mather"
          class={logo.mode === 'dark'
            ? "h-7 w-auto [data-color-preset='dawn']_&:hidden"
            : "h-7 w-auto hidden [data-color-preset='dawn']_&:block"}
          data-logo={logo.mode}
        />
      ))}
    </a>

    <!-- Desktop links -->
    <ul class="hidden lg:flex items-center gap-6 list-none m-0 p-0">
      {data.links.filter(l => l.label !== 'Contact Us').map((link) => (
        <li>
          <a
            href={link.href}
            class="
              text-xs font-mono tracking-widest uppercase
              text-[var(--muted-foreground)]
              hover:text-[var(--foreground)]
              transition-colors duration-150
            "
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Right controls -->
    <div class="flex items-center gap-3 shrink-0">
      <!-- Static placeholder: visible immediately on page load, removed once React mounts -->
      <button
        id="tsw-static"
        aria-hidden="true"
        style="display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 8px;border:1px solid var(--border);border-radius:var(--radius);color:var(--muted-foreground);background:transparent;cursor:pointer;font-size:12px;white-space:nowrap"
      >
        <span id="tsw-static-dots" style="display:inline-flex;gap:3px;align-items:center"></span>
        <span id="tsw-static-label">Void</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </button>
      <script is:inline>
        (function () {
          var LABELS = { cosmos:'Cosmos', dawn:'Dawn', void:'Void', sun:'Sun', moon:'Moon', blackhole:'Blackhole', pulsar:'Pulsar', nebula:'Nebula' };
          var SWATCHES = {
            cosmos:    ['oklch(0.58 0.26 272)','oklch(0.82 0.14 200)','oklch(0.67 0.22 350)'],
            dawn:      ['oklch(0.52 0.26 272)','oklch(0.48 0.14 200)','oklch(0.60 0.22 350)'],
            void:      ['oklch(0.62 0.28 272)','oklch(0.85 0.18 195)','oklch(0.70 0.24 350)'],
            sun:       ['oklch(0.62 0.20 60)', 'oklch(0.68 0.18 42)', 'oklch(0.55 0.24 28)'],
            moon:      ['oklch(0.40 0.010 242)','oklch(0.55 0.008 242)','oklch(0.48 0.040 270)'],
            blackhole: ['oklch(0.68 0.22 52)', 'oklch(0.58 0.26 18)', 'oklch(0.62 0.24 245)'],
            pulsar:    ['oklch(0.75 0.24 196)','oklch(0.60 0.28 332)','oklch(0.78 0.22 142)'],
            nebula:    ['oklch(0.62 0.26 346)','oklch(0.65 0.18 178)','oklch(0.55 0.22 312)'],
          };
          var saved = localStorage.getItem('color-preset') || 'void';
          var labelEl = document.getElementById('tsw-static-label');
          var dotsEl = document.getElementById('tsw-static-dots');
          if (labelEl) labelEl.textContent = LABELS[saved] || saved;
          if (dotsEl && SWATCHES[saved]) {
            SWATCHES[saved].forEach(function (c) {
              var dot = document.createElement('span');
              dot.style.cssText = 'display:inline-block;width:8px;height:8px;border-radius:50%;background:' + c + ';flex-shrink:0';
              dotsEl.appendChild(dot);
            });
          }
        })();
      </script>
      <ThemeSwitcher client:only="react" />

      <a
        href="#contact"
        class="
          hidden lg:inline-flex items-center
          px-3 py-1.5 rounded-sm
          text-xs font-mono tracking-widest uppercase
          bg-[var(--primary)] text-[var(--primary-foreground)]
          btn-glow
        "
      >
        Contact
      </a>

      <!-- Mobile hamburger -->
      <button
        id="nav-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="nav-drawer"
        class="lg:hidden flex flex-col justify-center gap-1.5 w-8 h-8 text-[var(--foreground)]"
      >
        <span class="block h-px w-6 bg-current transition-transform duration-200" data-bar="1"></span>
        <span class="block h-px w-6 bg-current transition-opacity duration-200" data-bar="2"></span>
        <span class="block h-px w-6 bg-current transition-transform duration-200" data-bar="3"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile drawer -->
  <div
    id="nav-drawer"
    class="
      lg:hidden hidden
      border-t border-[var(--line)]
      bg-[var(--background)]
      px-6 py-6
    "
  >
    <ul class="flex flex-col gap-4 list-none m-0 p-0">
      {data.links.map((link) => (
        <li>
          <a
            href={link.href}
            class="
              block text-sm font-mono tracking-widest uppercase
              text-[var(--muted-foreground)]
              hover:text-[var(--foreground)]
              transition-colors duration-150
            "
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('nav-toggle');
    var drawer = document.getElementById('nav-drawer');
    if (!btn || !drawer) return;

    btn.addEventListener('click', function () {
      var open = drawer.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!open));
      var bars = btn.querySelectorAll('[data-bar]');
      if (!open) {
        bars[0].style.transform = 'translateY(6px) rotate(45deg)';
        bars[1].style.opacity = '0';
        bars[2].style.transform = 'translateY(-6px) rotate(-45deg)';
      } else {
        bars[0].style.transform = '';
        bars[1].style.opacity = '';
        bars[2].style.transform = '';
      }
    });

    /* Close drawer when a link is clicked */
    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        drawer.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        var bars = btn.querySelectorAll('[data-bar]');
        bars[0].style.transform = '';
        bars[1].style.opacity = '';
        bars[2].style.transform = '';
      });
    });

    /* Logo swap: show light logo on light-mode presets, dark logo on dark-mode presets */
    function syncLogo() {
      var isDark = document.documentElement.classList.contains('dark');
      var dark = document.querySelector('[data-logo="dark"]');
      var light = document.querySelector('[data-logo="light"]');
      if (!dark || !light) return;
      dark.style.display  = isDark ? 'block' : 'none';
      light.style.display = isDark ? 'none'  : 'block';
    }

    syncLogo();

    var observer = new MutationObserver(syncLogo);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-color-preset'] });
  })();
</script>
