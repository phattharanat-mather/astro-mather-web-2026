---
import type { ClientsData } from '@/content-definition/home';
import { ClientsMarquee } from '@/components/ClientsMarquee';

interface Props {
  data: ClientsData;
}

const { data } = Astro.props;
---

<section class="py-24 border-b border-[var(--line)] overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="mb-12" data-reveal>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--ink);">
        {data.heading}
      </h2>
      <p class="mt-2 text-[var(--muted-foreground)]">{data.intro}</p>
    </div>
  </div>

  <ClientsMarquee client:load />
</section>

<style is:global>
  @keyframes marquee-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes marquee-right {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }

  .marquee-left  { animation: marquee-left  28s linear infinite; }
  .marquee-right { animation: marquee-right 32s linear infinite; }
</style>
