---
import { getCollection, render } from 'astro:content';
import SplashModal3DCard from './SplashModal3DCard.tsx';
import { X } from 'lucide-react';

const entries = await getCollection('announcements');
const entry = entries
  .filter((e) => e.data.active)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))[0];

if (!entry) return;

const { Content } = await render(entry);
const storageKey = `splash-hidden-${entry.id}`;

const sizeClass = entry.data.size === 'large' ? 'max-w-2xl' : 'max-w-lg';

const img = entry.data.image;
const hasText = !!entry.data.title;

// Explicit layout wins; fallback: image-only, text-only, or image-top (default)
type Layout = 'image-top' | 'image-left' | 'image-right' | 'image-only' | 'text-only';
let layout: Layout;
if (entry.data.variant) {
  layout = entry.data.variant as Layout;
} else if (!img) {
  layout = 'text-only';
} else if (!hasText) {
  layout = 'image-only';
} else {
  layout = 'image-top';
}

const ariaLabelledBy = hasText && layout !== 'image-only' ? 'splash-title' : undefined;
const ariaModalLabel = ariaLabelledBy ? undefined : (entry.data.title || 'Announcement');
---

{entry.data.card3d && img ? (
  <SplashModal3DCard
    client:only="react"
    imageSrc={img.src}
    imageWidth={img.width}
    imageHeight={img.height}
    title={entry.data.title}
    storageKey={storageKey}
    sizeClass={sizeClass}
    variant={layout}
  >
    <Content />
  </SplashModal3DCard>
) : (
<div
  id="splash-modal-backdrop"
  class="fixed inset-0 z-[9999] flex items-center justify-center bg-[oklch(0.07_0.022_264/80%)] backdrop-blur-sm p-8"
>
  <div
    id="splash-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby={ariaLabelledBy}
    aria-label={ariaModalLabel}
    tabindex="-1"
    class={`relative w-full h-full sm:h-auto ${sizeClass} rounded overflow-hidden border border-white/[8%] bg-[oklch(0.10_0.030_264)] outline-none`}
  >

    {/* ── Close button ── */}
    <button
      id="splash-close"
      aria-label="Close"
      class="absolute top-3 right-3 z-10 rounded p-1.5 text-white/40 transition hover:bg-white/10 hover:text-white/80"
    >
      <X size={14} />
    </button>

    {/* ── Image only ── */}
    {layout === 'image-only' && img && (
      <img
        src={img.src}
        alt=""
        width={img.width}
        height={img.height}
        class="w-full h-auto block"
      />
    )}

    {/* ── Image top / content bottom ── */}
    {layout === 'image-top' && img && (
      <>
        <img
          src={img.src}
          alt=""
          width={img.width}
          height={img.height}
          class="w-full h-auto block"
        />
        <div class="p-8">
          {entry.data.title && (
            <h2 id="splash-title" class="mb-4 text-xl font-semibold tracking-tight text-[oklch(0.93_0.025_272)]">
              {entry.data.title}
            </h2>
          )}
          <div class="prose prose-invert prose-sm max-w-none text-white/70">
            <Content />
          </div>
        </div>
      </>
    )}

    {/* ── Image left / content right ── */}
    {(layout === 'image-left' || layout === 'image-right') && img && (
      <div class={`flex flex-col h-full${layout === 'image-right' ? ' sm:flex-row-reverse sm:h-auto' : ' sm:flex-row sm:h-auto'}`}>
        <img
          src={img.src}
          alt=""
          width={img.width}
          height={img.height}
          class="w-full shrink-0 object-cover max-h-[50%] sm:max-h-none sm:w-2/5 sm:self-stretch"
        />
        <div class="flex flex-col p-8 flex-1 overflow-y-auto">
          {entry.data.title && (
            <h2 id="splash-title" class="mb-4 text-xl font-semibold tracking-tight text-[oklch(0.93_0.025_272)]">
              {entry.data.title}
            </h2>
          )}
          <div class="prose prose-invert prose-sm max-w-none text-white/70 grow">
            <Content />
          </div>
        </div>
      </div>
    )}

    {/* ── Text only ── */}
    {layout === 'text-only' && (
      <div class="p-8">
        {entry.data.title && (
          <h2 id="splash-title" class="mb-4 text-xl font-semibold tracking-tight text-[oklch(0.93_0.025_272)]">
            {entry.data.title}
          </h2>
        )}
        <div class="prose prose-invert prose-sm max-w-none text-white/70">
          <Content />
        </div>
      </div>
    )}

  </div>
</div>
)}

<script define:vars={{ storageKey, isCard3d: !!entry.data.card3d }}>
  if (!isCard3d) {
    (function () {
      var backdrop = document.getElementById('splash-modal-backdrop');
      var modal = document.getElementById('splash-modal');

      var stored = localStorage.getItem(storageKey);
      if (stored && Date.now() > parseInt(stored, 10)) {
        localStorage.removeItem(storageKey);
      }

      if (localStorage.getItem(storageKey)) {
        backdrop.remove();
        return;
      }

      var prevFocus = document.activeElement;
      var closeBtn = document.getElementById('splash-close');

      modal.focus();

      function close() {
        backdrop.remove();
        if (prevFocus && prevFocus.focus) prevFocus.focus();
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
      });

      closeBtn.addEventListener('click', close);

      backdrop.addEventListener('click', function (e) {
        if (e.target === backdrop) close();
      });
    })();
  }
</script>
