---
import { getCollection, render } from 'astro:content';
import SplashModal3DCard from './SplashModal3DCard.tsx';

const entries = await getCollection('splashModals');
const entry = entries
  .filter((e) => e.data.active)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))[0];

if (!entry) return;

const { Content } = await render(entry);
const storageKey = `splash-hidden-${entry.id}`;

const sizeClass = entry.data.size === 'large' ? 'max-w-2xl' : 'max-w-lg';

const img = entry.data.image;
const hasText = !!entry.data.title;

// Explicit layout wins; fallback: image-only, text-only, or image-top (default)
type Layout = 'image-top' | 'image-left' | 'image-right' | 'image-only' | 'text-only';
let layout: Layout;
if (entry.data.variant) {
  layout = entry.data.variant as Layout;
} else if (!img) {
  layout = 'text-only';
} else if (!hasText) {
  layout = 'image-only';
} else {
  layout = 'image-top';
}
---

{entry.data.card3d && img ? (
  <SplashModal3DCard
    client:only="react"
    imageSrc={img.src}
    imageWidth={img.width}
    imageHeight={img.height}
    title={entry.data.title}
    storageKey={storageKey}
    sizeClass={sizeClass}
    variant={layout}
  >
    <Content />
  </SplashModal3DCard>
) : (
<div
  id="splash-modal-backdrop"
  class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4"
>
  <div
    id="splash-modal"
    class={`relative w-full ${sizeClass} rounded-2xl shadow-2xl overflow-hidden border border-white/10 bg-[var(--color-surface,#0d0f1c)]`}
  >

    {/* ── Image only ── */}
    {layout === 'image-only' && img && (
      <>
        <img
          src={img.src}
          alt=""
          width={img.width}
          height={img.height}
          class="w-full h-auto block"
        />
        <div class="flex justify-end gap-3 px-6 py-4">
          <button id="splash-hide-today" class="rounded-lg border border-white/20 px-5 py-2 text-sm text-white/60 transition hover:bg-white/10">
            Hide for today
          </button>
          <button id="splash-close" class="rounded-lg bg-white px-5 py-2 text-sm font-medium text-black transition hover:bg-white/90">
            Close
          </button>
        </div>
      </>
    )}

    {/* ── Image top / content bottom ── */}
    {layout === 'image-top' && img && (
      <>
        <img
          src={img.src}
          alt=""
          width={img.width}
          height={img.height}
          class="w-full h-auto block"
        />
        <div class="p-8">
          {entry.data.title && (
            <h2 class="mb-4 text-xl font-semibold tracking-tight text-white">
              {entry.data.title}
            </h2>
          )}
          <div class="prose prose-invert prose-sm max-w-none text-white/70">
            <Content />
          </div>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-end">
            <button id="splash-hide-today" class="rounded-lg border border-white/20 px-5 py-2 text-sm text-white/60 transition hover:bg-white/10">
              Hide for today
            </button>
            <button id="splash-close" class="rounded-lg bg-white px-5 py-2 text-sm font-medium text-black transition hover:bg-white/90">
              Close
            </button>
          </div>
        </div>
      </>
    )}

    {/* ── Image left / content right ── */}
    {(layout === 'image-left' || layout === 'image-right') && img && (
      <div class={`flex flex-row${layout === 'image-right' ? '-reverse' : ''}`}>
        <img
          src={img.src}
          alt=""
          width={img.width}
          height={img.height}
          class="w-2/5 shrink-0 object-cover self-stretch"
        />
        <div class="flex flex-col p-8">
          {entry.data.title && (
            <h2 class="mb-4 text-xl font-semibold tracking-tight text-white">
              {entry.data.title}
            </h2>
          )}
          <div class="prose prose-invert prose-sm max-w-none text-white/70 grow">
            <Content />
          </div>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-end">
            <button id="splash-hide-today" class="rounded-lg border border-white/20 px-5 py-2 text-sm text-white/60 transition hover:bg-white/10">
              Hide for today
            </button>
            <button id="splash-close" class="rounded-lg bg-white px-5 py-2 text-sm font-medium text-black transition hover:bg-white/90">
              Close
            </button>
          </div>
        </div>
      </div>
    )}

    {/* ── Text only ── */}
    {layout === 'text-only' && (
      <div class="p-8">
        {entry.data.title && (
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-white">
            {entry.data.title}
          </h2>
        )}
        <div class="prose prose-invert prose-sm max-w-none text-white/70">
          <Content />
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-end">
          <button id="splash-hide-today" class="rounded-lg border border-white/20 px-5 py-2 text-sm text-white/60 transition hover:bg-white/10">
            Hide for today
          </button>
          <button id="splash-close" class="rounded-lg bg-white px-5 py-2 text-sm font-medium text-black transition hover:bg-white/90">
            Close
          </button>
        </div>
      </div>
    )}

  </div>
</div>
)}

<script define:vars={{ storageKey, isCard3d: !!entry.data.card3d }}>
  if (!isCard3d) {
    (function () {
      var backdrop = document.getElementById('splash-modal-backdrop');

      var stored = localStorage.getItem(storageKey);
      if (stored && Date.now() > parseInt(stored, 10)) {
        localStorage.removeItem(storageKey);
      }

      if (localStorage.getItem(storageKey)) {
        backdrop.remove();
        return;
      }

      function close() {
        backdrop.remove();
      }

      document.getElementById('splash-close').addEventListener('click', close);

      document.getElementById('splash-hide-today').addEventListener('click', function () {
        var midnight = new Date();
        midnight.setHours(23, 59, 59, 999);
        localStorage.setItem(storageKey, midnight.getTime().toString());
        close();
      });

      backdrop.addEventListener('click', function (e) {
        if (e.target === backdrop) close();
      });
    })();
  }
</script>
